{
  "expo": {
    "name": "Horas do Pioneiro",
    "slug": "pioneiro-horas",
    "owner": "junior.passamani",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pioneirohoras",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3D2E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pioneirohoras.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usar Face ID para desbloquear o aplicativo com seus dados de serviço."
      }
    },
    "android": {
      "package": "com.pioneirohoras.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3D2E"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "534f0eae-2edb-44d9-8fbf-54e9541bcc16"
      }
    }
  }
}
