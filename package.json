{
  "name": "pioneiro-horas",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "description": "Registro de Atividades do Pioneiro Regular — controle das 600h do Ano de Serviço (offline-first).",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "assets": "node scripts/generate-assets.mjs",
    "test": "node --experimental-strip-types --import ./scripts/register.mjs --test \"src/**/*.test.ts\"",
    "test:engine": "node --experimental-strip-types --import ./scripts/register.mjs --test src/domain/__tests__/engine.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "audit": "npm audit --omit=dev --audit-level=high",
    "build:apk": "eas build --platform android --profile preview",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@op-engineering/op-sqlite": "^11.2.7",
    "@react-native-community/datetimepicker": "8.2.0",
    "date-fns": "^4.1.0",
    "expo": "~52.0.0",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.0",
    "expo-document-picker": "~13.0.0",
    "expo-file-system": "~18.0.0",
    "expo-linking": "~7.0.0",
    "expo-local-authentication": "~15.0.0",
    "expo-router": "~4.0.0",
    "expo-screen-capture": "~7.0.1",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gifted-charts": "^1.4.54",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-svg": "15.8.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^8.0.1",
    "typescript": "~5.3.3"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "private": true
}
