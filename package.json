{
  "name": "pioneiro-horas",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "description": "Registro de Atividades do Pioneiro Regular — controle das 600h do Ano de Serviço (offline-first).",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "assets": "node scripts/generate-assets.mjs",
    "test": "node --experimental-strip-types --import ./scripts/register.mjs --test \"src/**/*.test.ts\"",
    "test:engine": "node --experimental-strip-types --import ./scripts/register.mjs --test src/domain/__tests__/engine.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "audit": "npm audit --omit=dev --audit-level=high",
    "build:apk": "eas build --platform android --profile preview",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@op-engineering/op-sqlite": "^18.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "date-fns": "^4.1.0",
    "expo": "^57.0.14",
    "expo-build-properties": "~57.0.12",
    "expo-constants": "~57.0.12",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-local-authentication": "~57.0.2",
    "expo-router": "~57.0.14",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.13",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.4",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "private": true
}
